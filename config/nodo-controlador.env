# /etc/default/nodo-controlador: ajustes del controlador de energía
INTERVAL=30       # segundos entre revisiones
IDLE_MIN=15       # minutos ocioso antes de dormir un nodo
WAKE_GRACE=300    # segundos de margen tras despertar
DRY_RUN=1         # 1 = solo anuncia lo que haría (empezar así); 0 = actúa de verdad
