# ============================================================================
# config/local.env: the values that belong to YOUR installation.
#
# Every @@NAME@@ marker in the repository is replaced with the value below when
# you run desplegar.ps1 (deploy) or desplegar.ps1 -Generar (render the k8s and
# firewall files into privado/generado/). The real file, config/local.env, is
# ignored by git; this .example is the template to copy.
#
#   copy config\local.env.example config\local.env   (then edit it)
# ============================================================================

# --- Domain -----------------------------------------------------------------
# A free DuckDNS subdomain is enough: it is only used to get a valid HTTPS
# certificate (DNS-01) for services that are reachable from the LAN/VPN only.
DOMINIO=my-cluster.duckdns.org

# --- Home network -----------------------------------------------------------
RED_CASA=192.168.1.0/24          # LAN
IP_ROUTER=192.168.1.1
IP_PI=192.168.1.20                   # Raspberry Pi (control plane, always on)
IP_FARADAY=192.168.1.21         # CPU node (sleeps when idle)
IP_MUSTANG=192.168.1.22         # GPU node + NAS (sleeps when idle)
IP_ADMIN=192.168.1.100             # your admin PC: SSH, kubectl
IP_MOVIL=192.168.1.101             # your phone on the home Wi-Fi: web + NAS without VPN
RED_VPN=10.10.10.0/24                # WireGuard subnet

# --- Wake-on-LAN (MAC addresses of the sleeping nodes) ---------------------
# Empty = keep the one already installed in /usr/local/bin/nodo
MAC_FARADAY=
MAC_MUSTANG=

# --- Users ------------------------------------------------------------------
USUARIO_PI=raspberrypi
USUARIO_FARADAY=faraday
USUARIO_MUSTANG=mustang
USUARIO_AUTHELIA=alice    # your Authelia user (FileBrowser single sign-on)

# --- Panel ------------------------------------------------------------------
CIUDAD_NOMBRE=Barcelona       # weather widget and "home" dot on the world map
CIUDAD_LAT=41.3874
CIUDAD_LON=2.1686

# --- Commit guard (.githooks/pre-commit) ------------------------------------
# A commit is BLOCKED if it contains the value of any of these variables, or
# any of the extra words. Add here anything that must never reach GitHub.
CLAVES_SENSIBLES="DOMINIO IP_ADMIN IP_MOVIL MAC_FARADAY MAC_MUSTANG CIUDAD_NOMBRE CIUDAD_LAT CIUDAD_LON"
TEXTOS_PRIVADOS="words-that-must-never-be-published"
